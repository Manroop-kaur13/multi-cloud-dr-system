# ==============================================================================
# Multi-Cloud Disaster Recovery System - Environment Configuration Example
# Copy this file to .env (or deployment/.env) and update values before running.
# NEVER commit real passwords, database URLs, or cloud credentials.
# ==============================================================================

# --- Application Runtime ---
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
CLOUD_ROLE=SIMULATION_CONTROLLER
SIMULATION_MODE=true

# --- PostgreSQL Configuration ---
# DB_MODE: "auto" (uses PostgreSQL if reachable, falls back to in-memory pg-mem locally),
#          "postgres" (strict PostgreSQL connection), or "memory" (forced local pg-mem)
DB_MODE=auto
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me_local_dev_password
PGDATABASE=multicloud_dr
# Optional unified connection string (overrides individual PG* vars when set):
# DATABASE_URL=postgresql://postgres:change_me_local_dev_password@localhost:5432/multicloud_dr

# --- Health Monitoring & Failover Tuning ---
HEALTH_CHECK_INTERVAL_MS=5000
FAILURE_THRESHOLD=2
AUTO_FAILOVER_ENABLED=true
RTO_TARGET_SECONDS=15
RPO_TARGET_SECONDS=5

# --- Cloud Provider Endpoints & Regions (Placeholders / Simulation Targets) ---
AWS_REGION=us-east-1
AWS_PRIMARY_ENDPOINT=https://primary.aws-sim.example.internal/api/health
GCP_REGION=us-central1
GCP_SECONDARY_ENDPOINT=https://standby.gcp-sim.example.internal/api/health

# --- Future Cloud Credentials (Leave blank in local simulation mode) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ROUTE53_HOSTED_ZONE_ID=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Frontend Vite Configuration ---
VITE_API_BASE_URL=http://localhost:5000/api
